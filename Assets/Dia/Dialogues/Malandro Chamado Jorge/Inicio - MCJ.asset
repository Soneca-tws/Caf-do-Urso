  m_Script: {fileID: 11500000, guid: 02d6315f0b7fc4d49b45a8ac6bc01ac5, type: 3}
  m_Name: Inicio - MCJ
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  sequenceID: 
  lines:
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 0
    text: Acorda, malucoooooo
    tags: []
    estadoDoNPC: 1
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 0
    text: "Aonde j\xE1 se viu o barista dormir no expediente ???"
    tags: []
    estadoDoNPC: 5
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "O Malandro Chamado Jorge, \xE9 um cara bastante peculiar e conhecido na
      sua cidade, e talvez at\xE9 no mundo. "
    tags: []
    estadoDoNPC: 0
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "(boatos dizem que ele conhece o presidente e at\xE9 o papa.)\r\n "
    tags: []
    estadoDoNPC: 0
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "Ele DESTESTA quando as pessoas abreviam seu nome para algo como Jorge,
      ou malandro ou qualquer coisa do tipo, ele s\xF3 aceita ser chamado pelo nome
      inteiro *O Malandro Chamado Jorge*.\r\n "
    tags: []
    estadoDoNPC: 0
  - author: Juruna, O barista
    ehOBarista: 1
    ehNarracao: 0
    text: 'Foi mal mano, sei nem como eu cheguei aqui ou peguei no sono parando pra
      pensar.. '
    tags: []
    estadoDoNPC: 0
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 0
    text: "T\xE1 vacilando Juruna? Faz o meu caf\xE9 a\xED! "
    tags: []
    estadoDoNPC: 7
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "Voc\xEA deu a sorte do seu primeiro cliente ser o agiota que voc\xEA pediu
      dinheiro para montar a cafeteria. "
    tags: []
    estadoDoNPC: 5
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "Pelo menos ele n\xE3o parece lembrar desse assunto, at\xE9 ele ter o caf\xE9
      dele na mesa\u2026"
    tags: []
    estadoDoNPC: 4
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 0
    text: "Meu brother, me v\xEA aquele caf\xE9 docinho igual eu tomava na merenda
      da escola bora agiliza!"
    tags: []
    estadoDoNPC: 7
  - author: Malandro Chamado Jorge
    ehOBarista: 0
    ehNarracao: 1
    text: "Que escola \xE9 essa que servia caf\xE9 na merenda pros alunos!?"
    tags: []
    estadoDoNPC: 7
  proximoDialogo: {fileID: 0}
  receitaDesejada:
  - "Caf\xE9"
  - "A\xE7\xFAcar"
  dialogoSucesso: {fileID: 11400000, guid: d3bcab4025f361e4a944be823eca20f1, type: 2}
